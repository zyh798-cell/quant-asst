# ============================================================
# Quant Asst 环境变量模板 —— 复制为 .env 后填写
# 所有密钥只从环境变量读取，严禁写进代码或提交到 git
#
# 加载顺序（在项目根目录运行 cli.py 时）：
#   1) 进程已有环境变量优先（不会被 .env 覆盖）
#   2) 项目根目录 .env 由 CLI 启动时自动加载
#   3) Windows PowerShell 临时注入：$env:DEEPSEEK_API_KEY = "sk-xxx"
#   4) Windows 永久写入：[Environment]::SetEnvironmentVariable("DEEPSEEK_API_KEY", "sk-xxx", "User")
# ============================================================

# ---- LLM（LiteLLM 格式：provider/model）----
# DeepSeek（推荐）
QUANT_ASST_LLM_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=sk-xxxxxxxx

# OpenAI（可选替换）
# QUANT_ASST_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-xxxxxxxx

# 其他 LiteLLM 支持的模型：密钥环境变量名以 https://docs.litellm.ai 文档为准
# QUANT_ASST_LLM_MODEL=anthropic/claude-3-5-sonnet
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# ---- 市场 ----
QUANT_ASST_DEFAULT_MARKET=cn_stock   # cn_stock | us_stock | hk_stock | futures | crypto

# ---- Qdrant 向量库 ----
QUANT_ASST_QDRANT_MODE=local         # local（进程内，零依赖）| server（docker-compose 启动）
QUANT_ASST_QDRANT_URL=http://localhost:6333

# ---- Docker 沙箱 ----
QUANT_ASST_SANDBOX_IMAGE=quant-asst-sandbox:latest
QUANT_ASST_SANDBOX_TIMEOUT_SECONDS=120
QUANT_ASST_SANDBOX_MEMORY_LIMIT=1g

# ---- 回测成本（A股默认口径，各市场完整规则见 backtest/market_rules.py）----
QUANT_ASST_TRADE_COST_RATE=0.0015    # 双边各 0.15%（含佣金与税费总口径）
QUANT_ASST_SLIPPAGE_RATE=0.001       # 滑点 0.1%
